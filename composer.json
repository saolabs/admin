{
    "name": "saola/admin",
    "description": "Reusable Saola admin shell, source publishing, database translations and schema-based settings",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "saola/core": "^2.4",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0",
        "saola/compiler": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Saola\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saola\\Admin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saola\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "homepage": "https://github.com/saolabs/admin",
    "support": {
        "issues": "https://github.com/saolabs/admin/issues",
        "source": "https://github.com/saolabs/admin"
    },
    "keywords": [
        "saola",
        "laravel",
        "admin",
        "settings",
        "translations"
    ]
}
