<script setup lang="ts">
    @vars(field: any = {}, error: string = '', locked: boolean = false, onChange: any = null, onMedia: any = null, mediaAvailable: boolean = false)

    App.Admin.controllers.input($view, () => ({field, error, locked, onChange, onMedia, mediaAvailable}));
</script>

<template>
        <div id="resource-field-{{ field['key'] }}" tabindex="-1" role="group" aria-labelledby="resource-label-{{ field['key'] }}" aria-describedby="resource-help-{{ field['key'] }} resource-error-{{ field['key'] }}" aria-invalid="{{ error ? 'true' : 'false' }}" class="sa-admin-matrix table-responsive">
            <table class="table table-sm align-middle sa-admin-matrix-table">
                <thead>
                    <tr>
                        <th class="sa-admin-matrix-name" scope="col">{{ text('admin.matrix.item') }}</th>
                        <th class="sa-admin-matrix-cell" scope="col"><label class="sa-admin-choice"><input class="form-check-input" type="checkbox" aria-label="{{ text('admin.matrix.all') }}" @checked(field['matrix']['all']) @disabled(locked || field['readOnly']) @change(toggleMany(field['matrix']['values'], $event))><span>{{ text('admin.matrix.all') }}</span></label></th>
                        @foreach(field['matrix']['headers'] as header)
                            @key(header['key'])
                            <th class="sa-admin-matrix-cell" scope="col"><label class="sa-admin-choice"><input class="form-check-input" type="checkbox" aria-label="{{ (header['label'] ?? '') ? header['label'] : text(header['labelKey']) }}" @checked(header['all']) @disabled(locked || field['readOnly'] || !header['any']) @change(toggleMany(header['values'], $event))><span>{{ (header['label'] ?? '') ? header['label'] : text(header['labelKey']) }}</span></label></th>
                        @endforeach
                    </tr>
                </thead>
                <tbody>
                    @foreach(field['matrix']['rows'] as row)
                        @key(row['key'])
                        <tr class="sa-admin-matrix-row sa-admin-matrix-{{ row['kind'] }} sa-admin-matrix-depth-{{ row['depth'] }}">
                            <th class="sa-admin-matrix-name" scope="row">{{ (row['label'] ?? '') ? row['label'] : text(row['labelKey']) }}</th>
                            <td class="sa-admin-matrix-cell"><input class="form-check-input" type="checkbox" aria-label="{{ text('admin.matrix.all') }}" @checked(row['all']) @disabled(locked || field['readOnly'] || !row['any']) @change(toggleMany(row['values'], $event))></td>
                            @foreach(row['cells'] as cell)
                                <td class="sa-admin-matrix-cell">@if(cell['enabled'])<input class="form-check-input" type="checkbox" @checked(cell['all']) @disabled(locked || field['readOnly']) @change(toggleMany(cell['values'], $event))>@endif</td>
                            @endforeach
                        </tr>
                    @endforeach
                </tbody>
            </table>
        </div>
</template>
