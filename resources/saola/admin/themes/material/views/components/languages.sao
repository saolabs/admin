<script setup lang="ts">
    @vars(editor: any = {})
    @state(localeDoc: any = editor['document'], permissions: any = editor['permissions'], batches: any[] = editor['batches'], busy: boolean = false, dirty: boolean = false, canSave: boolean = false, canPublish: boolean = false, selectedLocale: string = '', baseline: string = '', fileName: string = '', preview: any = null, changes: any[] = [])

    App.Admin.controllers.languages($view, () => ({editor}));
</script>

<template>
    <section class="card sa-admin-card">
        <h2 class="card-header fs-15">{{ __('admin.languages.defaults') }}</h2>
        <form @submit.prevent(save())>
            <fieldset class="sa-admin-form-fieldset sa-admin-locale-fields" @disabled(busy || !permissions['manage'])>
                <legend class="visually-hidden sa-admin-visually-hidden">{{ __('admin.languages.defaults') }}</legend>
                <div class="sa-admin-locale-defaults">
                    <div class="sa-admin-form-field">
                        <label for="language-ui-default">{{ __('admin.languages.ui_default') }}</label>
                        <select class="form-select" id="language-ui-default" @change(changeDefault('uiDefault', $event))>
                            @foreach(localeDoc['locales'] as row)
                                @if(row['uiEnabled'] && row['revision'] > 0)
                                    <option value="{{ row['code'] }}" @selected(row['code'] === localeDoc['uiDefault'])>{{ row['name'] === row['code'] ? row['code'] : sprintf('%s (%s)', row['name'], row['code']) }}</option>
                                @endif
                            @endforeach
                        </select>
                    </div>
                    <div class="sa-admin-form-field">
                        <label for="language-ui-fallback">{{ __('admin.languages.ui_fallback') }}</label>
                        <select class="form-select" id="language-ui-fallback" @change(changeDefault('uiFallback', $event))>
                            @foreach(localeDoc['locales'] as row)
                                @if(row['uiEnabled'] && row['revision'] > 0)
                                    <option value="{{ row['code'] }}" @selected(row['code'] === localeDoc['uiFallback'])>{{ row['name'] === row['code'] ? row['code'] : sprintf('%s (%s)', row['name'], row['code']) }}</option>
                                @endif
                            @endforeach
                        </select>
                    </div>
                    <div class="sa-admin-form-field">
                        <label for="language-content-default">{{ __('admin.languages.content_default') }}</label>
                        <select class="form-select" id="language-content-default" @change(changeDefault('contentDefault', $event))>
                            @foreach(localeDoc['locales'] as row)
                                @if(row['contentEnabled'])
                                    <option value="{{ row['code'] }}" @selected(row['code'] === localeDoc['contentDefault'])>{{ row['name'] === row['code'] ? row['code'] : sprintf('%s (%s)', row['name'], row['code']) }}</option>
                                @endif
                            @endforeach
                        </select>
                    </div>
                </div>
                <p class="text-muted small sa-admin-muted sa-admin-locale-hint">{{ __('admin.languages.locale_hint') }}</p>
                <div class="table-responsive sa-admin-table-scroll">
                    <table class="table table-hover align-middle mb-0 sa-admin-table sa-admin-locales-table">
                        <thead><tr><th scope="col">{{ __('admin.languages.code') }}</th><th scope="col">{{ __('admin.languages.name') }}</th><th scope="col">{{ __('admin.languages.country') }}</th><th scope="col">{{ __('admin.languages.currency') }}</th><th scope="col" class="text-center">{{ __('admin.languages.ui_enabled') }}</th><th scope="col" class="text-center">{{ __('admin.languages.content_enabled') }}</th><th scope="col">{{ __('admin.languages.status_label') }}</th></tr></thead>
                        <tbody>
                            @foreach(localeDoc['locales'] as row)
                                @key(row['code'])
                                <tr>
                                    <td><code class="sa-admin-locale-code">{{ row['code'] }}</code></td>
                                    <td><input class="form-control" aria-label="{{ __('admin.languages.name') }} {{ row['code'] }}" type="text" maxlength="100" value="{{ row['name'] }}" @input(changeName(row['code'], $event))></td>
                                    <td><input class="form-control sa-admin-locale-short" list="sa-admin-countries" placeholder="VN" aria-label="{{ __('admin.languages.country') }} {{ row['code'] }}" type="text" maxlength="2" value="{{ row['country'] }}" @input(changeText(row['code'], 'country', $event))></td>
                                    <td><input class="form-control sa-admin-locale-short" list="sa-admin-currencies" placeholder="VND" aria-label="{{ __('admin.languages.currency') }} {{ row['code'] }}" type="text" maxlength="3" value="{{ row['currency'] }}" @input(changeText(row['code'], 'currency', $event))></td>
                                    <td class="text-center"><div class="form-check form-switch form-switch-md d-inline-block"><input class="form-check-input" role="switch" aria-label="{{ __('admin.languages.ui_enabled') }} {{ row['code'] }}" type="checkbox" @checked(row['uiEnabled']) @change(changeFlag(row['code'], 'uiEnabled', $event))></div></td>
                                    <td class="text-center"><div class="form-check form-switch form-switch-md d-inline-block"><input class="form-check-input" role="switch" aria-label="{{ __('admin.languages.content_enabled') }} {{ row['code'] }}" type="checkbox" @checked(row['contentEnabled']) @change(changeFlag(row['code'], 'contentEnabled', $event))></div></td>
                                    <td><span class="badge bg-primary-subtle text-primary sa-admin-badge">{{ row['revision'] > 0 ? text('admin.languages.status.published') : text('admin.languages.unpublished') }}</span></td>
                                </tr>
                            @endforeach
                        </tbody>
                    </table>
                    <datalist id="sa-admin-countries">@foreach(editor['reference']['countries'] ?? [] as item)<option value="{{ item['code'] }}" label="{{ item['name'] }}"></option>@endforeach</datalist>
                    <datalist id="sa-admin-currencies">@foreach(editor['reference']['currencies'] ?? [] as item)<option value="{{ item['code'] }}" label="{{ item['name'] }}"></option>@endforeach</datalist>
                </div>
            </fieldset>
            <div class="sa-admin-form-actions">
                <button class="btn btn-primary" id="language-save" type="submit" @disabled(!canSave)><i class="ri-save-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.settings.save') }}</button>
                <button class="btn btn-light" type="button" @disabled(busy || !dirty) @click(discard())><i class="ri-arrow-go-back-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.settings.discard') }}</button>
                <button class="btn btn-light" type="button" @disabled(busy || dirty) @click(reload())><i class="ri-refresh-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.settings.reload') }}</button>
            </div>
        </form>
        @if(permissions['manage'])
            <details class="sa-admin-add-language">
                <summary>{{ __('admin.languages.add') }}</summary>
                <form class="sa-admin-locale-add-form" @submit.prevent(add($event))>
                    <div class="sa-admin-form-field"><label for="language-new-code">{{ __('admin.languages.code') }}</label>
                        <input class="form-control" id="language-new-code" placeholder="{{ __('admin.languages.code_placeholder') }}" name="code" type="text" maxlength="40" required @disabled(busy)></div>
                    <div class="sa-admin-form-field"><label for="language-new-name">{{ __('admin.languages.name') }}</label>
                        <input class="form-control" id="language-new-name" placeholder="{{ __('admin.languages.name_placeholder') }}" name="name" type="text" maxlength="100" required @disabled(busy)></div>
                    <div class="sa-admin-form-field"><label for="language-new-country">{{ __('admin.languages.country') }}</label>
                        <input class="form-control" id="language-new-country" list="sa-admin-countries" placeholder="VN" name="country" type="text" maxlength="2" @disabled(busy)></div>
                    <div class="sa-admin-form-field"><label for="language-new-currency">{{ __('admin.languages.currency') }}</label>
                        <input class="form-control" id="language-new-currency" list="sa-admin-currencies" placeholder="VND" name="currency" type="text" maxlength="3" @disabled(busy)></div>
                    <button class="btn btn-primary" type="submit" @disabled(busy)><i class="ri-add-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.languages.add') }}</button>
                </form>
            </details>
        @endif
    </section>
    <section class="card sa-admin-card">
        <h2 class="card-header fs-15">{{ __('admin.languages.translations') }}</h2>
        <div class="sa-admin-form-fields sa-admin-translation-fields">
            <div class="sa-admin-translation-tools">
                <div class="sa-admin-form-field">
                    <label for="language-target">{{ __('admin.languages.target') }}</label>
                    <select class="form-select" id="language-target" @disabled(busy || dirty) @change(selectLocale($event))>
                        @foreach(localeDoc['locales'] as row)
                            <option value="{{ row['code'] }}" @selected(row['code'] === selectedLocale)>{{ row['name'] === row['code'] ? row['code'] : sprintf('%s (%s)', row['name'], row['code']) }}</option>
                        @endforeach
                    </select>
                </div>
                @if(permissions['export'])
                    <button class="btn btn-light" id="language-export" type="button" @disabled(busy || dirty) @click(exportJson())><i class="ri-download-2-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.languages.export') }}</button>
                @endif
                @if(permissions['import'])
                    <div class="sa-admin-form-field sa-admin-file-field">
                        <label for="language-file">{{ __('admin.languages.file') }}</label>
                        <input class="form-control" id="language-file" type="file" accept="application/json,.json" @disabled(busy) @change(loadFile($event))>
                    </div>
                    <button class="btn btn-primary" id="language-preview" type="button" @disabled(busy || fileName === '' || baseline === '') @click(previewJson())><i class="ri-eye-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.languages.preview') }}</button>
                @endif
            </div>
            <details class="sa-admin-help">
                <summary>{{ __('admin.languages.import_options') }}</summary>
                <p>{{ __('admin.languages.json_hint') }}</p>
                <p>{{ __('admin.languages.defaults_hint') }}</p>
                @if(permissions['import'])
                    <div class="sa-admin-form-field">
                        <label for="language-baseline">{{ __('admin.languages.baseline') }}</label>
                        <input class="form-control" id="language-baseline" placeholder="{{ __('admin.languages.baseline_placeholder') }}" type="text" value="{{ baseline }}" @disabled(busy) @input(changeBaseline($event))>
                    </div>
                @endif
            </details>
            @if(preview)
                <p class="sa-admin-preview-status"><span class="badge bg-primary-subtle text-primary sa-admin-badge">{{ text(sprintf('admin.languages.status.%s', preview['status'])) }}</span> {{ preview['locale'] }} · {{ __('admin.languages.untranslated') }}: {{ preview['untranslated'].length }}</p>
                <p class="text-muted small sa-admin-muted">{{ __('admin.languages.preview_limit') }}</p>
                <dl class="sa-admin-language-preview">
                    @foreach(changes as change)
                        @key(change['key'])
                        <div><dt>{{ change['key'] }}</dt><dd>{{ change['value'] }}</dd></div>
                    @endforeach
                </dl>
                <div class="sa-admin-form-actions">
                    <button class="btn btn-light" id="language-draft" type="button" @disabled(busy || dirty || preview['status'] === 'published') @click(apply(false))><i class="ri-draft-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.languages.draft') }}</button>
                    @if(permissions['publish'])
                        <button class="btn btn-primary" id="language-publish" type="button" @disabled(!canPublish) @click(apply(true))><i class="ri-upload-2-line align-bottom me-1" aria-hidden="true"></i>{{ __('admin.languages.publish') }}</button>
                    @endif
                </div>
            @endif
        </div>
    </section>
    <details class="card sa-admin-card sa-admin-history">
        <summary>{{ __('admin.languages.recent') }} <span class="badge bg-primary-subtle text-primary sa-admin-badge">{{ batches.length }}</span></summary>
        <div class="sa-admin-history-list">
            @foreach(batches as batch)
                @key(batch['batch'])
                <div class="sa-admin-history-item" title="{{ batch['batch'] }}">
                    <span>{{ batch['locale'] }} · {{ text(sprintf('admin.languages.status.%s', batch['status'])) }}</span>
                    @if(batch['kind'] === 'export')
                        <button class="btn btn-light" type="button" @disabled(busy || dirty) @click(useBaseline(batch['locale'], batch['batch']))>{{ __('admin.languages.use_baseline') }}</button>
                    @elseif(permissions['import'])
                        <button class="btn btn-light" type="button" @disabled(busy || dirty) @click(openBatch(batch['batch']))>{{ __('admin.languages.open_preview') }}</button>
                    @endif
                </div>
            @endforeach
            @if(batches.length === 0)
                <p class="text-muted text-center p-4 sa-admin-empty">{{ __('admin.resource.empty') }}</p>
            @endif
        </div>
    </details>
</template>
