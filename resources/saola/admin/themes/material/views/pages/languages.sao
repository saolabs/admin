@await
<script setup lang="ts">
    @vars(languageEditor: any = {}, navigation: any[] = [], currentPage: string = '', brand: string = '', branding: any = {}, locales: any[] = [], dictionaryPattern: string = '', uiLocale: string = '', account: any = {})

    App.Admin.controllers.page($view, () => currentPage);
</script>

<template>
