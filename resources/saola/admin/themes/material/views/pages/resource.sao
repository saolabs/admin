@await
<script setup lang="ts">
    @vars(page: any = {}, management: any = null, navigation: any[] = [], currentPage: string = '', brand: string = '', branding: any = {}, locales: any[] = [], dictionaryPattern: string = '', uiLocale: string = '', account: any = {})

    App.Admin.controllers.page($view, () => currentPage);
</script>

<template>
    @serverside
        @section('meta:title', text(page['titleKey']))
    @endserverside
    @extends(__base__ + 'layouts.shell', {navigation: navigation, currentPage: currentPage, brand: brand, branding: branding, locales: locales, dictionaryPattern: dictionaryPattern, uiLocale: uiLocale, account: account})
    @block('heading')
        <h1 id="admin-page-title">{{ text(page['titleKey'] ?? 'admin.shell.title') }}</h1>
    @endblock
    @block('content')
        @if(management)
            @include(__base__ + 'components.manager', {resource: management})
        @else
            @include(__base__ + 'components.resource', {page: page})
        @endif
    @endblock
</template>
