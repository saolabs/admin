@vars(editor: any = {})
@state(fields: any[] = editor['fields'], busy: boolean = false, dirty: boolean = false, canSave: boolean = false, canUpdate: boolean = editor['canUpdate'], notice: string = '', errors: any = {})
<template>
    <header class="sa-admin-heading">
        <p class="sa-admin-eyebrow">{{ __('admin.settings.title') }}</p>
        <h1 id="admin-page-title">{{ text(editor['titleKey']) }}</h1>
        <p>{{ __('admin.settings.description_hint') }}</p>
    </header>
    <nav class="sa-admin-settings-groups" aria-label="{{ __('admin.settings.groups') }}">
        @foreach(editor['groups'] as group)
            @key(group['key'])
            <a href="{{ group['url'] }}" @class({'is-active': group['key'] === editor['group']})>{{ text(group['titleKey']) }}</a>
        @endforeach
    </nav>
    <section class="sa-admin-card">
        <form action="{{ editor['endpoint'] }}" method="post" @submit.prevent(save())>
            <input type="hidden" name="_token" value="{{ editor['csrfToken'] }}">
            <input type="hidden" name="_method" value="PUT">
            <div class="sa-admin-form-toolbar">
                <label for="settings-content-locale">{{ __('admin.settings.content_locale') }}</label>
                <select id="settings-content-locale" @disabled(busy) @change(changeContentLocale($event))>
                    @foreach(editor['document']['contentLocales'] as code)
                        <option value="{{ code }}" @selected(code === editor['contentLocale'])>{{ code }}</option>
                    @endforeach
                </select>
                <span>{{ __('admin.settings.locale_hint') }}</span>
            </div>
            @if(notice !== '')
                <p id="settings-notice" class="sa-admin-alert" role="status">{{ text(notice) }}</p>
            @endif
            @if(!canUpdate)
                <p class="sa-admin-empty">{{ __('admin.settings.read_only') }}</p>
            @endif
            <fieldset class="sa-admin-form-fields" @disabled(busy || !canUpdate)>
                <legend class="sa-admin-visually-hidden">{{ text(editor['titleKey']) }}</legend>
                @foreach(fields as field)
                    @key(field['key'])
                    <div class="sa-admin-form-field">
                        <label for="setting-{{ field['key'] }}">{{ text(field['labelKey']) }}</label>
                        @if(field['type'] === 'boolean')
                            <input id="setting-{{ field['key'] }}" name="{{ field['key'] }}" type="checkbox" @checked(field['value'] === true) @change(changeCheckbox(field['key'], $event))>
                        @elseif(field['type'] === 'integer')
                            <input id="setting-{{ field['key'] }}" name="{{ field['key'] }}" type="number" step="1" min="{{ field['min'] }}" max="{{ field['max'] }}" value="{{ field['value'] }}" aria-describedby="hint-{{ field['key'] }} error-{{ field['key'] }}" @input(changeNumber(field['key'], $event))>
                        @else
                            <input id="setting-{{ field['key'] }}" name="{{ field['key'] }}" type="text" maxlength="{{ field['maxLength'] }}" value="{{ field['value'] }}" aria-describedby="hint-{{ field['key'] }} error-{{ field['key'] }}" @input(changeText(field['key'], $event))>
                        @endif
                        <small id="hint-{{ field['key'] }}">
                            {{ field['present'] ? text('admin.settings.stored') : text('admin.settings.fallback') }}
                            {{ field['localized'] ? text('admin.settings.localized') : text('admin.settings.shared') }}
                        </small>
                        @if(errors[field['key']] ?? '')
                            <p id="error-{{ field['key'] }}" class="sa-admin-field-error" role="alert">{{ text(errors[field['key']]) }}</p>
                        @endif
                    </div>
                @endforeach
            </fieldset>
            <div class="sa-admin-form-actions">
                <button id="settings-save" type="submit" @disabled(!canSave)>{{ busy ? text('admin.settings.saving') : text('admin.settings.save') }}</button>
                <button id="settings-discard" type="button" @disabled(busy || !dirty) @click(discard())>{{ __('admin.settings.discard') }}</button>
                <button id="settings-reload" type="button" @disabled(busy || dirty) @click(reload())>{{ __('admin.settings.reload') }}</button>
            </div>
        </form>
    </section>
</template>
<script setup lang="ts">
    let form: any;
    let disposers: Array<() => void> = [];
    let active = false;
    function refresh() {
        if (!active || !form) return;
        setFields(form.fields.map((field: any) => ({...field})));
        setBusy(form.busy); setDirty(form.dirty); setCanSave(form.canSave);
        setCanUpdate(form.canUpdate); setErrors({...form.errors}); setNotice(form.notice);
    }
    function canLeave() {
        if (form.canLeave()) return true;
        form.notice = 'admin.settings.unsaved'; refresh(); return false;
    }
    function beforeUnload(event: BeforeUnloadEvent) {
        if (!form.canLeave()) { event.preventDefault(); event.returnValue = ''; }
    }
    function activate() {
        if (active) return;
        active = true;
        const ui = App.make<any>('AdminUI');
        if (!form) form = ui.createSettingsForm(editor);
        disposers.push(ui.registerLanguageGuard(canLeave));
        const router = App.Router as any;
        disposers.push(router.addNavigationGuard(canLeave));
        window.addEventListener('beforeunload', beforeUnload);
        App.Head?.setTitle(App.Helper.text(editor['titleKey'])); refresh();
    }
    function deactivate() {
        active = false; disposers.splice(0).forEach(dispose => dispose());
        window.removeEventListener('beforeunload', beforeUnload); form?.suspend();
    }
    function started() { activate(); }
    function resumed() { activate(); }
    function paused() { deactivate(); }
    function stopped() { deactivate(); }
    function destroyed() { deactivate(); }
    function changeText(key: string, event: Event) { form.change(key, (event.target as HTMLInputElement).value); refresh(); }
    function changeNumber(key: string, event: Event) {
        const input = event.target as HTMLInputElement;
        form.change(key, Number.isFinite(input.valueAsNumber) ? input.valueAsNumber : input.value); refresh();
    }
    function changeCheckbox(key: string, event: Event) { form.change(key, (event.target as HTMLInputElement).checked); refresh(); }
    function discard() { form.discard(); refresh(); }
    async function save() { const pending = form.save(); refresh(); await pending; refresh(); }
    async function reload() { const pending = form.reload(); refresh(); await pending; refresh(); }
    function changeContentLocale(event: Event) {
        const input = event.target as HTMLSelectElement;
        if (!canLeave()) { input.value = editor['contentLocale']; return; }
        const target = new URL(window.location.href);
        target.searchParams.set('content_locale', input.value);
        (App.Router as any).replace(target.pathname + target.search);
    }
</script>
