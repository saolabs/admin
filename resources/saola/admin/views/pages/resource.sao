@vars(page: any = {}, navigation: any[] = [], currentPage: string = '', brand: string = '', locales: any[] = [], dictionaryPattern: string = '')
@await
<template>
    @serverside
        @section('meta:title', text(page['titleKey']))
    @endserverside
    @extends(__base__ + 'layouts.shell', {navigation: navigation, currentPage: currentPage, brand: brand, locales: locales, dictionaryPattern: dictionaryPattern})
    @block('content')
        @include(__base__ + 'components.resource', {page: page})
    @endblock
</template>
