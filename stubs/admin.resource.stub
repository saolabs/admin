<?php

namespace {{ namespace }};

use {{ model }};
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Http\Request;
use Saola\Admin\Resources\Resource;

/** List/form/trash of {{ modelBase }}; the package renders every screen. Labels: {{ lang }}.* */
class {{ class }} extends Resource
{
    public function key(): string { return '{{ key }}'; }
    public function titleKey(): string { return '{{ lang }}.title'; }
    /** Abilities {{ ability }}.view|create|update|delete|restore; a model Policy, when registered, takes over. */
    public function abilityPrefix(): string { return '{{ ability }}'; }
    public function navigation(): array { return ['icon' => 'list', 'order' => 100]; }
    public function model(): string { return {{ modelBase }}::class; }
    public function query(Request $request): Builder { return {{ modelBase }}::query(); }
    public function searchable(): array { return [{{ searchable }}]; }
    public function columns(): array
    {
        return array_map(fn ($key) => ['key' => $key, 'labelKey' => '{{ lang }}.fields.'.$key], [{{ columns }}]);
    }
    public function fields(): array
    {
        return [
{{ fields }}
        ];
    }
}
