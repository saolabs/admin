{
    "packages": {},
    "paths": {
        "resources": "resources",
        "saoView": "resources/saola",
        "bladeView": "resources/views",
        "compiled": "resources/js/saola",
        "public": "public/static/saola",
        "sharedApp": "_app"
    },
    "output": {
        "default": "app/js",
        "contexts": {
            "admin": "admin/js"
        }
    },
    "contexts": {
        "admin": {
            "name": "Admin Panel",
            "app": [
                "admin/app"
            ],
            "views": {
                "admin.themes.classic": "admin/themes/classic/views",
                "admin.themes.material": "admin/themes/material/views"
            },
            "blade": {
                "admin.themes.classic": "admin/themes/classic",
                "admin.themes.material": "admin/themes/material"
            },
            "compiled": {
                "views": "admin/views",
                "app": "admin/app",
                "registry": "admin/registry.js"
            }
        }
    },
    "compiler": {
        "idMode": "terse"
    }
}
